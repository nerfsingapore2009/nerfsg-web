rules_version = '2';

/*
 * PROPOSED replacement for firestore.rules — NOT DEPLOYED.
 *
 * Deploying this needs one decision from you first (see SECURITY-NOTES.md):
 * how an organiser is recognised. The `isOrganiser()` helper below is written
 * three ways; pick one, delete the others, then move this file over
 * firestore.rules and run `firebase deploy --only firestore:rules`.
 *
 * ── What is wrong with the current rules ────────────────────────────────
 *
 *   allow write: if request.auth != null;
 *
 * The website calls signInAnonymously() for every visitor on load. An
 * anonymous session IS a non-null request.auth. So the current rule grants
 * every visitor to nerfsg.com — and anyone who takes the Firebase config out
 * of the JS bundle, where it is public by design — permission to create,
 * overwrite and delete any document in `gamedays` and `events`. No bug in the
 * site is needed; the SDK is enough.
 *
 * Reads are a second, smaller issue. `allow read: if true` is correct for game
 * schedules, but gameday documents also carry attendee names, avatar URLs and
 * a paymentSubmissions map. Those are readable by anyone, in bulk. Splitting
 * payment data into a subcollection that only organisers can read is the fix,
 * and it needs a matching change in the NerfSG Hub app, so it is left as a
 * follow-up rather than smuggled in here.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── PICK ONE ─────────────────────────────────────────────────────
     *
     * Option A — custom claim. Best if you can run a one-off admin script:
     *   admin.auth().setCustomUserClaims(uid, { organiser: true })
     * Nothing extra is read at rule-evaluation time, so it is also the
     * cheapest.
     */
    function isOrganiser() {
      return request.auth != null && request.auth.token.organiser == true;
    }

    /* Option B — an allowlist collection. Best if you would rather manage
     * organisers from the Firebase console than run a script. Create
     * /organisers/<uid> documents (contents irrelevant, existence is the
     * signal). Costs one document read per write evaluation.
     *
     * function isOrganiser() {
     *   return request.auth != null
     *     && exists(/databases/$(database)/documents/organisers/$(request.auth.uid));
     * }
     */

    /* Option C — hardcoded UIDs. Fine for two or three organisers who never
     * change; every change needs a rules deploy.
     *
     * function isOrganiser() {
     *   return request.auth != null && request.auth.uid in [
     *     'PUT_ORGANISER_UID_HERE',
     *   ];
     * }
     */

    /* Anonymous visitors are readers, never writers. This is the whole point
     * of the change: the website only ever reads. */
    match /gamedays/{docId} {
      allow read: if true;
      allow create, update, delete: if isOrganiser();
    }

    match /events/{docId} {
      allow read: if true;
      allow create, update, delete: if isOrganiser();
    }

    /* Deny by default. Without this, a collection added later inherits
     * nothing and is closed — but stating it makes the intent explicit and
     * survives someone pasting a permissive rule above it. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
